{
  "realm": "flip",
  "enabled": true,
  "displayName": "FLIP Farm Platform",
  "displayNameHtml": "<strong>FLIP</strong> Farm Platform",
  "defaultLocale": "en",
  "internationalizationEnabled": true,
  "supportedLocales": ["en", "hi"],
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxLoginFailures": 10,
  "accessTokenLifespan": 300,
  "refreshTokenMaxReuse": 0,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      { "name": "farmer", "description": "Smallholder farmer with access to own farm data", "composite": false },
      { "name": "fpo_admin", "description": "FPO admin with read access to all member farms", "composite": false },
      { "name": "fpo_member", "description": "FPO member farmer", "composite": false },
      { "name": "agronomist", "description": "Expert agronomist who can review and annotate advisories", "composite": false },
      { "name": "gov_officer", "description": "Government officer with read-only GIS and aggregate views", "composite": false },
      { "name": "buyer", "description": "Marketplace buyer with access to market module", "composite": false },
      { "name": "logistics", "description": "Logistics provider with route and inventory access", "composite": false },
      { "name": "platform_admin", "description": "Platform superadmin", "composite": false },
      { "name": "device", "description": "IoT device / gateway service account", "composite": false }
    ]
  },
  "groups": [
    {
      "name": "farmers",
      "realmRoles": ["farmer"]
    },
    {
      "name": "fpo-admins",
      "realmRoles": ["fpo_admin"]
    },
    {
      "name": "experts",
      "realmRoles": ["agronomist"]
    },
    {
      "name": "government",
      "realmRoles": ["gov_officer"]
    }
  ],
  "clients": [
    {
      "clientId": "flip-web",
      "name": "FLIP Web PWA",
      "description": "Public OIDC client for farmer-facing Progressive Web App",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "rootUrl": "http://localhost:5173",
      "baseUrl": "http://localhost:5173",
      "redirectUris": [
        "http://localhost:5173/*",
        "https://staging.flip.farm/*",
        "https://flip.farm/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "https://staging.flip.farm",
        "https://flip.farm"
      ],
      "defaultClientScopes": ["web-origins", "profile", "roles", "email", "openid"],
      "optionalClientScopes": ["address", "phone", "offline_access"],
      "protocolMappers": [
        {
          "name": "org_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "org_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "org_id",
            "jsonType.label": "String"
          }
        },
        {
          "name": "flip_role",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "flip_role",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "flip_role",
            "jsonType.label": "String"
          }
        },
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "flip-api",
      "name": "FLIP Core API",
      "description": "Confidential client for FastAPI backend service",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "secret": "dev-secret",
      "defaultClientScopes": ["web-origins", "profile", "roles", "email", "openid"],
      "optionalClientScopes": ["address", "phone", "offline_access"],
      "protocolMappers": [
        {
          "name": "org_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "org_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "org_id",
            "jsonType.label": "String"
          }
        },
        {
          "name": "flip_role",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "flip_role",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "flip_role",
            "jsonType.label": "String"
          }
        },
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "flip-device",
      "name": "FLIP IoT Device",
      "description": "Service account for edge gateways and sensor nodes",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "secret": "dev-device-secret",
      "defaultClientScopes": ["web-origins", "roles", "openid"],
      "optionalClientScopes": [],
      "attributes": {
        "use.refresh.tokens": "false"
      }
    },
    {
      "clientId": "flip-m2m",
      "name": "FLIP M2M Gateway Client",
      "description": "Machine-to-machine client for Edge Gateway to Cloud token exchange & client-credentials authentication",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "secret": "dev-m2m-secret",
      "defaultClientScopes": ["web-origins", "roles", "openid"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "flip_role",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.value": "device",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "flip_role",
            "jsonType.label": "String"
          }
        }
      ],
      "attributes": {
        "client_credentials.use_refresh_token": "false"
      }
    }
  ],
