  "clientScopes": [
    {
      "name": "farm:read",
      "description": "Read access to farm data",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      }
    },
    {
      "name": "farm:write",
      "description": "Write access to farm data",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      }
    },
    {
      "name": "advisory:read",
      "description": "Read access to advisories",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      }
    }
