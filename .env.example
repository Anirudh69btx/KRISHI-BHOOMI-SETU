# ============================================================
# FLIP v3.0 — Environment Variables Template
# Copy this to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# Run: bash scripts/generate-secrets.sh to auto-generate.
# ============================================================

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://flip_user:flip_pass@localhost:5432/flip
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── NATS ─────────────────────────────────────────────────────────────────────
NATS_URL=nats://localhost:4222

# ── Keycloak / OIDC ──────────────────────────────────────────────────────────
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=flip
KEYCLOAK_CLIENT_ID=flip-api
KEYCLOAK_CLIENT_SECRET=change-me-in-production
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/flip/protocol/openid-connect/certs

# ── MinIO / S3 ────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_IMAGES=flip-images
MINIO_BUCKET_MODELS=flip-models

# ── EMQX MQTT ─────────────────────────────────────────────────────────────────
EMQX_HOST=localhost
EMQX_PORT=1883
EMQX_TLS_PORT=8883
EMQX_API_URL=http://localhost:18083
EMQX_API_KEY=
EMQX_API_SECRET=

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# ── Temporal ─────────────────────────────────────────────────────────────────
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=flip

# ── API ───────────────────────────────────────────────────────────────────────
FLIP_ENV=local
API_VERSION=3.0.0
SECRET_KEY=change-me-in-production-min-32-chars
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_API_WS_URL=ws://localhost:8000
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=flip
VITE_KEYCLOAK_CLIENT_ID=flip-web
VITE_MAPTILER_KEY=
VITE_SENTRY_DSN=

# ── Observability ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=flip-core-api
LOG_LEVEL=INFO

# ── Feature Flags ─────────────────────────────────────────────────────────────
ENABLE_DISASTER_DRILL=true
ENABLE_VOICE_COPILOT=true
ENABLE_3D_TERRAIN=true
FLIP_MIN_ACCURACY_THRESHOLD=0.75
