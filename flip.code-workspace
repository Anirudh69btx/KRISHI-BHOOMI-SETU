{
  "folders": [
    {
      "path": ".",
      "name": "FLIP v3.0 Monorepo"
    }
  ],
  "settings": {
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.rulers": [100],
    "files.eol": "\n",
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "search.exclude": {
      "**/node_modules": true,
      "**/.turbo": true,
      "**/.venv": true,
      "**/dist": true,
      "**/build": true,
      "**/__pycache__": true,
      "**/*.pyc": true
    },

    "python.defaultInterpreterPath": "${workspaceFolder}/services/core-api/.venv/bin/python",
    "python.analysis.typeCheckingMode": "basic",
    "[python]": {
      "editor.defaultFormatter": "charliermarsh.ruff",
      "editor.formatOnSave": true,
      "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit"
      }
    },
    "ruff.lint.args": ["--config=pyproject.toml"],

    "[typescript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[typescriptreact]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[json]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[yaml]": {
      "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[sql]": {
      "editor.tabSize": 4
    },

    "typescript.tsdk": "node_modules/typescript/lib",

    "tailwindCSS.experimental.classRegex": [
      ["cn\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"]
    ],

    "sqltools.connections": [
      {
        "name": "FLIP Local Postgres",
        "driver": "PostgreSQL",
        "server": "localhost",
        "port": 5432,
        "database": "flip",
        "username": "flip_user",
        "password": "flip_pass"
      }
    ],

    "rest-client.environmentVariables": {
      "local": {
        "baseUrl": "http://localhost:8000",
        "keycloakUrl": "http://localhost:8080",
        "realm": "flip",
        "clientId": "flip-api"
      }
    },

    "files.associations": {
      "*.hcl": "terraform",
      "*.conf": "nginx",
      "justfile": "makefile",
      "Procfile": "shellscript"
    }
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.vscode-pylance",
      "charliermarsh.ruff",
      "ms-toolsai.jupyter",
      "bradlc.vscode-tailwindcss",
      "esbenp.prettier-vscode",
      "dbaeumer.vscode-eslint",
      "graphql.vscode-graphql",
      "graphql.vscode-graphql-syntax",
      "ms-azuretools.vscode-docker",
      "redhat.vscode-yaml",
      "zxh404.vscode-proto3",
      "mtxr.sqltools",
      "mtxr.sqltools-driver-pg",
      "humao.rest-client",
      "eamodio.gitlens",
      "streetsidesoftware.code-spell-checker",
      "ms-vscode-remote.remote-containers",
      "tamasfe.even-better-toml",
      "github.copilot"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "🚀 Start Full Stack",
        "type": "shell",
        "command": "make up",
        "group": "build",
        "presentation": { "reveal": "always", "panel": "new" }
      },
      {
        "label": "🌐 Start Web Dev Server",
        "type": "shell",
        "command": "pnpm --filter @flip/web dev",
        "group": "build",
        "presentation": { "reveal": "always", "panel": "new" }
      },
      {
        "label": "🐍 Start Core API (uvicorn)",
        "type": "shell",
        "command": "cd services/core-api && uvicorn flip_api.main:app --reload --port 8000",
        "group": "build",
        "presentation": { "reveal": "always", "panel": "new" }
      },
      {
        "label": "🗄️  Run DB Migrations",
        "type": "shell",
        "command": "make migrate",
        "group": "build",
        "presentation": { "reveal": "always" }
      },
      {
        "label": "🧪 Run All Tests",
        "type": "shell",
        "command": "make test",
        "group": "test",
        "presentation": { "reveal": "always" }
      },
      {
        "label": "📡 Simulate Sensors",
        "type": "shell",
        "command": "python scripts/simulate_sensor.py --farm-id fa000001-0000-0000-0000-000000000001 --interval 5",
        "group": "build",
        "presentation": { "reveal": "always" }
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "🐍 Debug Core API",
        "type": "python",
        "request": "launch",
        "module": "uvicorn",
        "args": ["flip_api.main:app", "--reload", "--port", "8000"],
        "cwd": "${workspaceFolder}/services/core-api",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/services/core-api/src"
        },
        "jinja": true
      },
      {
        "name": "🌐 Debug Web (Edge)",
        "type": "chrome",
        "request": "launch",
        "url": "http://localhost:5173",
        "webRoot": "${workspaceFolder}/apps/web/src",
        "sourceMaps": true
      }
    ]
  }
}
